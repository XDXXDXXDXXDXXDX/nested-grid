{
  "name": "@nested-grid/core",
  "version": "0.6.0",
  "description": "Headless layout engine that maps tree data into hierarchical grid structures. Framework-agnostic, zero dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XDXXDXXDXXDXXDX/nested-grid.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/XDXXDXXDXXDXXDX/nested-grid/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/XDXXDXXDXXDXXDX/nested-grid/issues"
  },
  "keywords": [
    "css-grid",
    "grid-layout",
    "layout-engine",
    "tree",
    "nested",
    "hierarchical",
    "json-driven",
    "typescript",
    "framework-agnostic"
  ],
  "author": "dongxiang",
  "scripts": {
    "build": "webpack --config webpack.config.js && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild-loader": "^3.0.0",
    "webpack": "^5.97.0",
    "webpack-cli": "^6.0.1"
  }
}
