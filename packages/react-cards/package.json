  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XDXXDXXDXXDXXDX/nested-grid.git",
    "directory": "packages/react-cards"
  },
  "homepage": "https://xdxxdxxdxxdxxdx.github.io/nested-grid/",
  "bugs": {
    "url": "https://github.com/XDXXDXXDXXDXXDX/nested-grid/issues"
  },
  "keywords": [
    "css-grid",
    "grid-layout",
    "react",
    "card",
    "tree",
    "nested",
    "hierarchical",
    "json-driven",
    "theme",
    "css-custom-properties",
    "typescript"
  ],
  "author": "dongxiang",
  "scripts": {
    "build": "webpack --config webpack.config.js && tsc --emitDeclarationOnly",
