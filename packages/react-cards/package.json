  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@nested-grid/core": "workspace:*",
    "@nested-grid/react": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.29",
    "copy-webpack-plugin": "^14.0.0",
    "esbuild-loader": "^3.0.0",
    "react": "^18.3.1",
    "webpack": "^5.97.0",
    "webpack-cli": "^6.0.1"
  }
